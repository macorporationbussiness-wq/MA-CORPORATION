# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas)
# Replace with your actual MongoDB connection string
MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/dbname?appName=AppName

# JWT Secret for Admin Authentication
# Generate a strong secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Company WhatsApp Number (with country code, no + or spaces) e.g. 923001234567
WHATSAPP_NUMBER=923001234567

# OpenCode API Key for Chatbot (optional - chatbot works in fallback mode without it)
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_API_URL=https://opencode.ai/zen/v1/chat/completions
OPENCODE_MODEL=deepseek-v4-flash-free
