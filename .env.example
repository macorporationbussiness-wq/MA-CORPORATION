# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas)
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.fhadrwx.mongodb.net/?appName=Cluster0

# JWT Secret for Admin Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Company WhatsApp Number (with country code, no + or spaces) e.g. 923001234567
WHATSAPP_NUMBER=923001234567

# OpenCode API Key for Chatbot (optional - chatbot works in fallback mode without it)
OPENCODE_API_KEY=your_opencode_api_key
OPENCODE_API_URL=https://opencode.ai/zen/v1/chat/completions
OPENCODE_MODEL=deepseek-v4-flash-free

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret