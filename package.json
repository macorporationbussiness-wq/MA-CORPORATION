{
    "name": "ma-corporation-website",
    "version": "1.0.0",
    "description": "M.A. Corporation full-stack MERN platform",
    "main": "server.js",
    "scripts": {
        "server": "nodemon server.js",
        "client": "npm run dev --prefix client",
        "install:all": "npm install && npm install --prefix client",
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "build": "npm install --prefix client && npm run build --prefix client",
        "start": "node server.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.5.1",
        "multer": "^2.3.0"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "nodemon": "^3.1.4"
    }
}
